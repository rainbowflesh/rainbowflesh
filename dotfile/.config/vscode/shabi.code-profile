    "snippets": "{\"snippets\":{\"doc.code-snippets\":\"{\\n\\t\\\"doc\\\":{\\n\\t\\t\\\"prefix\\\":\\\"doc\\\",\\n\\t\\t\\\"body\\\":[\\n\\t\\t\\t\\\"/**\\\",\\n\\t\\t\\t\\\" * @description $1\\\",\\n\\t\\t\\t\\\" */\\\",\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"Generate document\\\"\\n\\t}\\n}\",\"html.json\":\"{\\n\\t\\\"html:5\\\": {\\n\\t\\t\\\"prefix\\\": \\\"!h\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"<!dOcTYpE html>\\\",\\n\\t\\t\\t\\\"<html>\\\",\\n\\t\\t\\t\\\"<head>\\\",\\n\\t\\t\\t\\\"\\\\t<meta charset=\\\\\\\"UTF-8\\\\\\\">\\\",\\n\\t\\t\\t\\\"\\\\t<meta name=\\\\\\\"viewport\\\\\\\" content=\\\\\\\"width=device-width, initial-scale=1.0\\\\\\\">\\\",\\n\\t\\t\\t\\\"\\\\t<meta http-equiv=\\\\\\\"X-UA-Compatible\\\\\\\" content=\\\\\\\"ie=edge\\\\\\\">\\\",\\n\\t\\t\\t\\\"\\\\t<title></title>\\\",\\n\\t\\t\\t\\\"</head>\\\",\\n\\t\\t\\t\\\"<body>\\\",\\n\\t\\t\\t\\\"</body>\\\",\\n\\t\\t\\t\\\"</html>\\\",\\n\\t\\t],\\n\\t\\t\\\"description\\\": \\\"HTML5\\\"\\n\\t}\\n}\",\"readme.code-snippets\":\"{\\n  \\\"readme template\\\": {\\n    \\\"scope\\\": \\\"markdown\\\",\\n    \\\"prefix\\\": \\\"readme\\\",\\n    \\\"body\\\": [\\n      \\\"# Document Template\\\",\\n      \\\"<!-- Use one line description here -->\\\",\\n      \\\"I'm highly recommend you use English to write document.\\\",\\n      \\\"<!-- Keep it simple and less -->\\\",\\n      \\\"Also highly recommend that follow [this](https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md) guide to write markdown.\\\",\\n      \\\"## Development\\\",\\n      \\\"To contribute to Mars colony program, follow the guide below 👇\\\",\\n      \\\"### Dependencies\\\",\\n      \\\"<!-- Make sure you have note the code-block type like this 'shell' -->\\\",\\n      \\\"```shell\\\",\\n      \\\"sudo echo 'Mars is mine!!!1'\\\",\\n      \\\"```\\\",\\n      \\\"\\\",\\n      \\\"### Usage\\\",\\n      \\\"\\\",\\n      \\\"```txt\\\",\\n      \\\"正在前往: 国会山\\\",\\n      \\\"```\\\",\\n      \\\"\\\",\\n      \\\"### Etc\\\",\\n      \\\"\\\",\\n      \\\"Why you have so much things to do.\\\",\\n      \\\"## Test\\\",\\n      \\\"\\\",\\n      \\\"### Unit Test maybe\\\",\\n      \\\"\\\",\\n      \\\"```shell\\\",\\n      \\\"sudo echo 'Wanna test this document?'\\\",\\n      \\\"```\\\",\\n      \\\"\\\",\\n      \\\"### Integrate Test\\\",\\n      \\\"\\\",\\n      \\\"## Deployment\\\",\\n      \\\"\\\",\\n      \\\"### Build\\\",\\n      \\\"\\\",\\n      \\\"### Docker\\\",\\n      \\\"\\\"\\n    ],\\n    \\\"description\\\": \\\"The readme template\\\"\\n  }\\n}\\n\",\"rust-test.code-snippets\":\"{\\n  \\\"test\\\": {\\n    \\\"scope\\\": \\\"rust\\\",\\n    \\\"prefix\\\": \\\"test\\\",\\n    \\\"body\\\": [\\n      \\\"#[cfg(test)]\\\",\\n      \\\"mod tests {\\\",\\n      \\\"#![cfg_attr(debug_assertions, allow(dead_code, unused_imports))]\\\",\\n      \\\"use super::*;\\\",\\n      \\\"\\\",\\n      \\\"#[test]\\\",\\n      \\\"/// a description\\\",\\n      \\\"fn test_$1($2) {}\\\",\\n      \\\"}\\\"\\n    ],\\n    \\\"description\\\": \\\"Gen rust test block\\\"\\n  }\\n}\\n\",\"rust-tokio-test.code-snippets\":\"{\\n  \\\"test\\\": {\\n    \\\"scope\\\": \\\"rust\\\",\\n    \\\"prefix\\\": \\\"test async\\\",\\n    \\\"body\\\": [\\n      \\\"#[cfg(test)]\\\",\\n      \\\"mod tests {\\\",\\n      \\\"#![cfg_attr(debug_assertions, allow(dead_code, unused_imports))]\\\",\\n      \\\"use super::*;\\\",\\n      \\\"\\\",\\n      \\\"#[tokio::test]\\\",\\n      \\\"/// a description\\\",\\n      \\\"async fn test_$1($2) {}\\\",\\n      \\\"}\\\"\\n    ],\\n    \\\"description\\\": \\\"Gen rust tokio async test block\\\"\\n  }\\n}\\n\",\"vue-html.json\":\"\\\"Print to console\\\": {\\n\\t\\\"prefix\\\": \\\"!vh\\\",\\n\\t\\\"body\\\": [\\n\\t\\t\\\"<template>\\\",\\n\\t\\t\\\"   <div></div>\\\",\\n\\t\\t\\\"</template>\\\",\\n\\t\\t\\\"\\\",\\n\\t\\t\\\"<script>\\\",\\n\\t\\t\\\"export default {\\\",\\n\\t\\t\\\"   data () {\\\",\\n\\t\\t\\\"  